#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "db.h" // 1. 引入数据库接口头文件

// --- 前向声明命令行函数 ---
static void cmd_open(int argc, char *argv[]);
static void cmd_insert(int argc, char *argv[]);
static void cmd_query(int argc, char *argv[]);
static void cmd_delete(int argc, char *argv[]);
static void cmd_status(int argc, char *argv[]);
static void cmd_setlevel(int argc, char *argv[]);
static void cmd_exit(int argc, char *argv[]);
static void parse_and_execute(char *line);

// --- 命令表 ---
static struct {
    const char *name;
    void (*handler)(int, char**);
} commands[] = {
    {"open", cmd_open},
    {"insert", cmd_insert},
    {"query", cmd_query},
    {"delete", cmd_delete},
    {"status", cmd_status},
    {"setlevel", cmd_setlevel},
    {"exit", cmd_exit},
    {NULL, NULL}
};

// --- 命令处理函数实现 ---

static void cmd_open(int argc, char *argv[]) {
    if (argc < 2) {
        printf("Usage: open <filename>\n");
        return;
    }
    // 这里假设你有一个 db_open 函数，如果没有，先打印个提示
    printf("Opening database: %s\n", argv[1]);
    // db_open(argv[1]); // 如果你在 db.c 里实现了 db_open，取消注释
}

static void cmd_insert(int argc, char *argv[]) {
    if (argc < 3) {
        printf("Usage: insert <data> <source_ip>\n");
        return;
    }
    int id = db_insert(argv[1], argv[2]);
    if (id > 0) {
        printf("Inserted record with ID: %d\n", id);
    } else {
        printf("Insert failed.\n");
    }
}

static void cmd_query(int argc, char *argv[]) {
    if (argc < 2) {
        printf("Usage: query <id>\n");
        return;
    }
    int id = atoi(argv[1]);
    // 注意：这里假设 Record 结构体定义在 db.h 或者通过 db.c 可见
    // 为了演示，我们假装查到了
    printf("Querying record ID: %d\n", id);
    // Record *rec = db_query(id);
    // if (rec) { ... }
}

static void cmd_delete(int argc, char *argv[]) {
    if (argc < 2) {
        printf("Usage: delete <id>\n");
        return;
    }
    int id = atoi(argv[1]);
    if (db_delete(id) == 0) {
        printf("Record %d deleted.\n", id);
    } else {
        printf("Delete failed.\n");
    }
}

static void cmd_status(int argc, char *argv[]) {
    db_status();
}

static void cmd_setlevel(int argc, char *argv[]) {
    if (argc < 2) {
        printf("Usage: setlevel <guest|admin>\n");
        return;
    }
    if (strcmp(argv[1], "admin") == 0) {
        // extern Database db; // 如果需要在 main.c 访问 db
        // db.permission_level = AUTH_ADMIN;
        printf("Permission level set to ADMIN.\n");
    } else if (strcmp(argv[1], "guest") == 0) {
        printf("Permission level set to GUEST.\n");
    } else {
        printf("Invalid level. Use 'guest' or 'admin'.\n");
    }
}

static void cmd_exit(int argc, char *argv[]) {
    printf("Exiting MindVault...\n");
    db_close();
    exit(0);
}

// --- 解析和执行逻辑 ---

static void parse_and_execute(char *line) {
    if (line == NULL || strlen(line) == 0) return;

    // 去除首尾空白和换行符
    while (*line == ' ' || *line == '\t') line++;
    char *end = line + strlen(line) - 1;
    while (end > line && (*end == ' ' || *end == '\t' || *end == '\n')) end--;
    *(end + 1) = '\0';

    if (strlen(line) == 0) return;

    // 分词
    int argc = 0;
    char *argv[20];
    char *tok = strtok(line, " ");
    while (tok && argc < 19) {
        argv[argc++] = tok;
        tok = strtok(NULL, " ");
    }

    // 查找并执行命令
    for (int i = 0; commands[i].name != NULL; i++) {
        if (strcmp(argv[0], commands[i].name) == 0) {
            commands[i].handler(argc, argv);
            return;
        }
    }
    printf("Unknown command: '%s'. Type 'help' for available commands.\n", argv[0]);
}

// --- 主函数 ---

int main(int argc, char *argv[]) {
    // 初始化数据库
    db_init(); // 2. 现在编译器知道这个函数了！

    printf("MindVault CLI v0.1.0\n");
    printf("Type 'help' for commands, 'exit' to quit.\n\n");

    // 非交互模式（直接传命令作为参数）
    if (argc > 1) {
        char line[1024] = {0};
        for (int i = 1; i < argc; i++) {
            strcat(line, argv[i]);
            if (i < argc - 1) strcat(line, " ");
        }
        parse_and_execute(line);
        return 0;
    }

    // 交互模式
    char line[1024];
    while (1) {
        printf("mv> ");
        if (fgets(line, sizeof(line), stdin) == NULL) break;
        parse_and_execute(line);
    }

    printf("\n");
    db_close();
    return 0;
}
